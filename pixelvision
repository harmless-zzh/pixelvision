#!/bin/sh
# Launcher: forward to the repo's virtualenv so callers need no active venv.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "pixelvision: no virtualenv at $ROOT/.venv" >&2
  echo "Run:  sh \"$ROOT/scripts/bootstrap.sh\"" >&2
  exit 2
fi
exec "$PY" "$ROOT/scripts/capture.py" "$@"
